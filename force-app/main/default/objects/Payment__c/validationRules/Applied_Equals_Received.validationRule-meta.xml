<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Applied_Equals_Received</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount_Received__c)), ABS((Principal_Applied__c + Interest_Applied__c + Fees_Applied__c) - Amount_Received__c) &gt; 0.01)</errorConditionFormula>
    <errorMessage>The sum of Principal, Interest, and Fees Applied must equal Amount Received.</errorMessage>
</ValidationRule>
