<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decline_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Decision__c, &quot;Declined&quot;), ISPICKVAL(Decline_Reason__c, &quot;&quot;))</errorConditionFormula>
    <errorMessage>Decline Reason is required when Decision is Declined.</errorMessage>
</ValidationRule>
