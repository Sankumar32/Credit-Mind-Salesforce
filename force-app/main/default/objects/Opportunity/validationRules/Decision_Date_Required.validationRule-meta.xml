<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decision_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Decision__c, &quot;&quot;)), ISBLANK(Decision_Date__c))</errorConditionFormula>
    <errorMessage>Decision Date is required when a Decision is set.</errorMessage>
</ValidationRule>
