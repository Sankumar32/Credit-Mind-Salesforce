<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tax_ID_Required_For_Customer</fullName>
    <active>true</active>
    <errorConditionFormula>IF(RecordType.DeveloperName = &quot;Customer&quot;, ISBLANK(Tax_ID__c), FALSE)</errorConditionFormula>
    <errorMessage>Tax ID is required for Customer accounts.</errorMessage>
</ValidationRule>
