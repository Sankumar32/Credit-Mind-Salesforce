<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ownership_Pct_Range</fullName>
    <active>true</active>
    <errorConditionFormula>Ownership_Pct__c &gt; 100 || Ownership_Pct__c &lt; 0</errorConditionFormula>
    <errorMessage>Ownership percentage must be between 0 and 100.</errorMessage>
</ValidationRule>
